# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Where uploaded PDFs are written (local disk for now)
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
MAX_PAGES=50

CHUNK_SIZE=200
CHUNK_OVERLAP=40
LOG_LEVEL=INFO

# --- LLM (Google Gemini). Leave empty to run with rule-based metadata only ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional second model used when the first one fails (e.g. quota)
GEMINI_FALLBACK_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
