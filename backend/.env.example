# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Where uploaded PDFs are written (local disk for now)
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
MAX_PAGES=50

CHUNK_SIZE=200
CHUNK_OVERLAP=40
LOG_LEVEL=INFO

# --- LLM (NVIDIA NIM, free key from build.nvidia.com; see docs/MODEL_SELECTION.md) ---
# Leave empty to run with rule-based metadata only
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
