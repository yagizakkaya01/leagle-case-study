# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- PDF storage. Empty connection string = local folder (backend/storage).
# Azure Blob: paste the storage account connection string. Local emulator with
# `docker compose up -d azurite`:
# DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents
# STORAGE_DIR=
MAX_UPLOAD_MB=10
MAX_PAGES=50

CHUNK_SIZE=200
CHUNK_OVERLAP=40
LOG_LEVEL=INFO

# --- Chat history. Empty = in memory (lost on restart).
# With `docker compose up -d db`: postgresql://leagle:leagle@127.0.0.1:5432/leagle
DATABASE_URL=

# --- LLM (NVIDIA NIM, free key from build.nvidia.com; see docs/MODEL_SELECTION.md) ---
# Leave empty to run with rule-based metadata only
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
# Only for reasoning models that accept it (e.g. Mistral Large 4): low | medium | high.
# Leave empty for models without a reasoning setting (e.g. google/gemma-4-31b-it).
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
