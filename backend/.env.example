# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Where uploaded PDFs are written (default: backend/storage)
# STORAGE_DIR=
MAX_UPLOAD_MB=10
MAX_PAGES=50

CHUNK_SIZE=200
CHUNK_OVERLAP=40
LOG_LEVEL=INFO

# --- LLM (NVIDIA NIM, free key from build.nvidia.com; see docs/MODEL_SELECTION.md) ---
# Leave empty to run with rule-based metadata only
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
# Only for reasoning models that accept it (e.g. Mistral Large 4): low | medium | high.
# Leave empty for models without a reasoning setting (e.g. google/gemma-4-31b-it).
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
